# ============================================
# LastCall — local environment (NEVER commit)
# ============================================

# --- Meta WhatsApp Cloud API (test number) ---
WHATSAPP_ACCESS_TOKEN=            # temp token from API Setup (~24h) — replace with System User token later
WHATSAPP_PHONE_NUMBER_ID=         # ID of the +1 555 test number (from API Setup page)
WHATSAPP_WABA_ID=                 # WhatsApp Business Account ID
WHATSAPP_TEST_RECIPIENT=          # your own number, digits only, e.g. 96171234567
WHATSAPP_API_VERSION=v21.0

# --- Webhook (used in step 4, set now, value is ours to invent) ---
WHATSAPP_WEBHOOK_VERIFY_TOKEN=    # any random string you make up, e.g. lastcall-verify-8f3k2

# --- Google Cloud ---
GCP_PROJECT_ID=lastcall-hackathon
GCP_REGION=europe-west1

# --- Vertex AI ---
VERTEX_LOCATION=europe-west1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_LITE=gemini-2.5-flash-lite